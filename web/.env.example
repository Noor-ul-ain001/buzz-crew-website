# Copy to web/.env.local and fill in. Never commit real values.

# Where the FastAPI service runs. /api/v1/* is rewritten there (DEPLOYMENT D2).
API_ORIGIN=http://localhost:8000


# WhatsApp Business number in international format, digits only
NEXT_PUBLIC_WHATSAPP_NUMBER=923000000000

# Content publishing (feature 004)
# Same value as REVALIDATE_SECRET in api/.env; the API calls /api/revalidate after publishing
REVALIDATE_SECRET=change-me
# Cloudinary cloud name (free plan), used by the image loader
NEXT_PUBLIC_CLOUDINARY_CLOUD=
