# Copy to api/.env and fill in. Never commit real values.
# All services below have free tiers; see specs/COSTS.md.

# Neon Postgres — use the POOLED connection string for the app (DEPLOYMENT D8)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/buzzcrew?sslmode=require
# Direct (unpooled) connection string, used only by Alembic migrations
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@HOST.REGION.aws.neon.tech/buzzcrew?sslmode=require
# Optional: tests start a throwaway local Postgres (pgserver) when this is empty
TEST_DATABASE_URL=

# Comma-separated web origins allowed by CORS and the CSRF Origin check
CLIENT_URL=http://localhost:3000

# Resend (email)
RESEND_API_KEY=re_xxx
EMAIL_FROM=The Buzz Crew <hello@thebuzzcrew.com>
TEAM_NOTIFICATION_EMAIL=buzzcrewofficial@gmail.com

# Random 32+ character strings
IP_HASH_SALT=change-me
CRON_SECRET=change-me

# Admin sign-in (feature 003)
# Check new passwords against Have I Been Pwned (free k-anonymity range API)
HIBP_ENABLED=false
# Web origin used in invitation and reset links
WEB_URL=http://localhost:3000
# Local development over http: set false so the browser keeps the session cookie
SESSION_COOKIE_SECURE=true

# Content publishing (feature 004)
# Cloudinary free plan: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
CLOUDINARY_FOLDER=buzzcrew
# Same value as REVALIDATE_SECRET in web/.env; random 32+ characters
REVALIDATE_SECRET=change-me

# Staff sign-up at /admin/signup (12+ characters). Leave empty to allow invitations only.
ADMIN_SIGNUP_CODE=
